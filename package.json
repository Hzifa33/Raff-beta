{
  "name": "raff-library",
  "version": "3.0.0",
  "description": "رَفّ 3.0.0 — نظام عربي محلي لإدارة وفهرسة المكتبات، مع وضع بحث عام آمن، مركز إعارات، نسخ احتياطية ذكية وسلامة بيانات محسّنة",
  "main": "main.js",
  "author": "Hzifa33",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "npm run dist:win:x64 && npm run dist:win:x86",
    "dist:linux": "electron-builder --linux",
    "test": "node tests/integrity.test.js",
    "dist:win:x64": "electron-builder --win nsis --x64 --publish never",
    "dist:win:x86": "electron-builder --win nsis --ia32 --publish never",
    "check": "npm test && node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hzifa33.raff",
    "productName": "رَفّ",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!assets/*-source.*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Raff-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "رَفّ"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  }
}
